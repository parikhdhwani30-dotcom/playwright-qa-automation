  },
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "test": "playwright test",
    "test:client": "npx playwright test --grep \"@sanity\" && npm run -s test:allure && node send-report.js",
    "test:allure": "allure generate allure-results --clean -o allure-report && node ./node_modules/allure-single-html-file-js/combine.js ./allure-report > nul 2>&1",
    "test:report": "allure open allure-report"
  },
