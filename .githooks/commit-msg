#!/usr/bin/env sh

commit_msg_file="$1"

if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  echo "Commit message file path is required."
  exit 1
fi

first_line="$(sed -n '1p' "$commit_msg_file" | tr -d '\r')"

if printf '%s\n' "$first_line" | grep -Eq '^(Merge |Revert )'; then
  exit 0
fi

if printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|enhance|improve)!?: .{1,72}$'; then
  exit 0
fi

echo ""
echo "Invalid commit message."
echo "Use Conventional Commits format:"
echo "type: short summary"
echo ""
echo "Examples:"
echo "  feat: add marketing event details step"
echo "  fix: switch workflows to npm ci"
echo "  chore: pin node and npm versions"
exit 1

